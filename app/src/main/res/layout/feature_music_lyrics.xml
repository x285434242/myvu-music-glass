<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="?attr/colorSurface">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/music_feature_title"
        android:textStyle="bold"
        android:textSize="17sp"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/music_feature_hint_new"
        android:textSize="13sp"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- Search row: song name + button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/txtSongName"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="@string/song_name_hint"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="14sp" />

        <Button android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/search" />
    </LinearLayout>

    <!-- Search results -->
    <TextView
        android:id="@+id/txtResultHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/search_results"
        android:textStyle="bold"
        android:textSize="13sp"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <ListView
        android:id="@+id/listSongs"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_marginTop="4dp"
        android:divider="?android:attr/dividerHorizontal"
        android:dividerHeight="1dp" />

    <!-- Now playing -->
    <TextView
        android:id="@+id/txtNowPlaying"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/nothing_playing"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary" />

    <!-- Playback controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button android:id="@+id/btnPlay"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/play" />
        <Button android:id="@+id/btnPause"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/pause" />
        <Button android:id="@+id/btnStop"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/stop" />
    </LinearLayout>

    <!-- Advanced: manual URL mode (collapsed by default via a toggle button) -->
    <Button android:id="@+id/btnToggleAdvanced"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/advanced_url_mode"
        android:textSize="12sp" />

    <LinearLayout android:id="@+id/advancedPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/txtMusicUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/music_url_hint"
            android:inputType="textUri"
            android:maxLines="1"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/txtLyricsUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/lyrics_url_hint"
            android:inputType="textUri"
            android:maxLines="1"
            android:textSize="14sp" />

        <Button android:id="@+id/btnLoadTrack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/load" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtMusicStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/ready"
        android:textSize="13sp"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
