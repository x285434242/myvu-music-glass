<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="?attr/colorSurface">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/music_feature_title"
        android:textStyle="bold"
        android:textSize="17sp"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/music_feature_hint"
        android:textSize="13sp"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <EditText
        android:id="@+id/txtMusicUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/music_url_hint"
        android:inputType="textUri"
        android:maxLines="1"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/txtLyricsUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/lyrics_url_hint"
        android:inputType="textUri"
        android:maxLines="1"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button android:id="@+id/btnLoadTrack"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/load" />
        <Button android:id="@+id/btnPlay"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/play" />
        <Button android:id="@+id/btnPause"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/pause" />
        <Button android:id="@+id/btnStop"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/stop" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtNowPlaying"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/nothing_playing"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary" />

    <TextView
        android:id="@+id/txtMusicStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/ready"
        android:textSize="13sp"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
